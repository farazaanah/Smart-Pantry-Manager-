<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F0E3"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#111318"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SMART PANTRY MANAGER"
            android:textColor="#1677FF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Suggest Recipes"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Find meals you can make with what you have."
            android:textColor="#D5D8DF"
            android:textSize="14sp"
            android:layout_marginTop="6dp" />

    </LinearLayout>

    <!-- Recipe matching message -->
    <TextView
        android:id="@+id/tvRecipeMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Checking your pantry..."
        android:textColor="#111318"
        android:textSize="14sp"
        android:background="#FFFFFF"
        android:padding="14dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="10dp" />

    <!-- Recipe list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRecipes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        android:scrollbars="vertical" />

</LinearLayout>

