<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F0E3"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#111318"
            android:padding="22dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SMART PANTRY MANAGER"
                android:textColor="#1677FF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Add Ingredient"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enter the details of an ingredient in your pantry."
                android:textColor="#D5D8DF"
                android:textSize="14sp"
                android:layout_marginTop="6dp" />

        </LinearLayout>

        <!-- Form -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:layout_marginTop="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ingredient Details"
                android:textColor="#111318"
                android:textSize="21sp"
                android:textStyle="bold"
                android:layout_marginBottom="18dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ingredient Name"
                android:textColor="#111318"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etIngredientName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:hint="e.g. Rice"
                android:inputType="textCapSentences"
                android:padding="12dp"
                android:backgroundTint="#1677FF"
                android:textColor="#111318"
                android:textColorHint="#777777"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Quantity"
                android:textColor="#111318"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etQuantity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:hint="e.g. 2"
                android:inputType="numberDecimal"
                android:padding="12dp"
                android:backgroundTint="#1677FF"
                android:textColor="#111318"
                android:textColorHint="#777777"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Unit"
                android:textColor="#111318"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etUnit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:hint="e.g. kg, g, ml, pieces"
                android:inputType="textCapSentences"
                android:padding="12dp"
                android:backgroundTint="#1677FF"
                android:textColor="#111318"
                android:textColorHint="#777777"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Expiry Date (Optional)"
                android:textColor="#111318"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etExpiryDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:hint="YYYY-MM-DD"
                android:inputType="date"
                android:padding="12dp"
                android:backgroundTint="#1677FF"
                android:textColor="#111318"
                android:textColorHint="#777777"
                android:layout_marginBottom="24dp" />

            <Button
                android:id="@+id/btnSaveIngredient"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Save Ingredient"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1677FF" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>


